{
  "name": "erp-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint:money": "node tools/lint-money.mjs",
    "stack:up": "node infra/scripts/stack.mjs up",
    "stack:down": "node infra/scripts/stack.mjs down",
    "stack:reset": "node infra/scripts/stack.mjs reset",
    "stack:bootstrap": "tsx infra/scripts/bootstrap.ts",
    "dev:token": "node infra/scripts/dev-token.mjs",
    "dev:api": "pnpm --filter @erp/api dev:stack",
    "dev:web": "pnpm --filter @erp/web dev",
    "lint:payroll": "node tools/lint-payroll.mjs",
    "dev:post-settled": "tsx infra/scripts/dev-post-settled.ts",
    "release:smoke": "pnpm --filter @erp/api build && infra/scripts/release-smoke.sh"
  },
  "devDependencies": {
    "@erp/db": "workspace:*",
    "@erp/ops": "workspace:*",
    "@types/pg": "^8.11.10",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@swc/core": "1.12.14",
      "@swc/wasm": "1.12.14"
    }
  }
}
