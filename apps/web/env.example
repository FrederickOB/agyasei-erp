# @erp/web — example environment (Vite).
# (Named env.example, not .env.example: this workspace's tooling denies
# .env* paths as a secrets guard — same convention as infra/env.example.
# Copy the values you need into apps/web/.env.local yourself.)
#
# ALL THREE unset → local-only mode: same local schema, zero backend, dev
# seed. That is the default and the honest offline rehearsal.
# ALL THREE set → sync mode: downloads stream from the PowerSync service
# (sync_rules.yaml buckets, scoped by the token's tid), uploads drain the
# outbox to POST /sync/upload and complete ONLY on a per-key server ack.

# API dev server (fixed dev contract — apps/api on localhost:3001).
VITE_API_URL=http://localhost:3001

# Self-hosted PowerSync service (fixed dev contract — localhost:8080).
VITE_POWERSYNC_URL=http://localhost:8080

# Development-only API bearer JWT, signed with DEV_JWT_SECRET
# (default "dev-secret-change-me" — see infra/env.example). The API exchanges
# it at GET /sync/token for the short-lived PowerSync client token; tenant
# identity (tid) comes from this verified token, never from the client.
# Real credential exchange is the online login flow (§8.2).
# NEVER commit a real token.
VITE_API_TOKEN=
