# @erp/web — example environment (Vite).
# (Named env.example, not .env.example: this workspace's tooling denies
# .env* paths as a secrets guard — same convention as infra/env.example.
# Copy the values you need into apps/web/.env.local yourself.)
#
# Nothing set → local-only mode: same local schema, zero backend, dev seed.
#
# VITE_API_URL + VITE_POWERSYNC_URL, NO token → THE DEVICE PATH (production):
# the tablet enrols with a one-time code from the back office, a person signs
# in through the identity provider (`pnpm dev:idp` locally), chooses a PIN,
# and every request carries a DPoP-bound token. Downloads are scoped by the
# device + user + tenant (migration 0024).
#
# All three set (VITE_API_TOKEN too) → DEV-BEARER mode: the static HS256 bearer
# from `pnpm dev:token`, kept for the drills and quick dev. Never in production.

# API dev server (fixed dev contract — apps/api on localhost:3001).
VITE_API_URL=http://localhost:3001

# Self-hosted PowerSync service (fixed dev contract — localhost:8080).
VITE_POWERSYNC_URL=http://localhost:8080

# DEV ONLY. Leave EMPTY to exercise the real device path.
# Development-only API bearer JWT, signed with DEV_JWT_SECRET
# (default "dev-secret-change-me" — see infra/env.example). The API exchanges
# it at GET /sync/token for the short-lived PowerSync client token; tenant
# identity (tid) comes from this verified token, never from the client.
# Real credential exchange is the online login flow (§8.2).
# NEVER commit a real token.
VITE_API_TOKEN=

# --- What the token provisions -----------------------------------------------
# This device binds itself to a location from the token's `locs` claim, on
# every start — the same claim the API enforces every write against
# (assertLocationInScope). `pnpm dev:token` mints exactly one, which is the
# unambiguous case and provisions with no manual step.
#   one location   → provisioned automatically.
#   several        → the app refuses to sell and asks which counter this is.
#   none           → the app refuses to sell and says the sign-in has no location.
# A location this device already holds that the token no longer covers is
# replaced by the token's, never traded on.
