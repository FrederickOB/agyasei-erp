{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The write path and Phase 1 routers: Fastify + tRPC, server-stamped HLC, one idempotent write pipeline over app.write_log.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:stack": "tsx src/dev.ts",
    "build": "node build.mjs",
    "start": "node dist/bin/main.js",
    "db:migrate": "node dist/bin/migrate.js",
    "jobs": "node dist/bin/jobs.js",
    "ops": "node dist/bin/ops.js"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "@erp/money": "workspace:*",
    "@erp/ops": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "superjson": "^2.2.2",
    "zod": "^3.24.1",
    "@erp/sequence": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "~0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
