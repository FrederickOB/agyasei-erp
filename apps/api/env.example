# @erp/api dev server — example environment.
# (Named env.example, not .env.example: this workspace's tooling denies
# writing/reading .env* paths as a secrets guard. Every value below is the
# default used when unset — `pnpm --filter @erp/api dev:stack` works bare
# against the running docker stack.)
# DEV VALUES ONLY — real secrets never live in the repository.

# Postgres 16 in docker (infra/), wal_level=logical.
# NOT the host's Postgres 14 on 5432.
DATABASE_URL=postgresql://erp:erp_dev@localhost:5433/erp

# DEV ONLY — the HS256 shared secret for `pnpm dev:token` bearers and the
# live drills, also accepted by the PowerSync dev config (aud "powersync").
# REFUSED at startup when NODE_ENV=production.
DEV_JWT_SECRET=dev-secret-change-me

# --- The production identity path (02-security §2.2, §2.7) ------------------
# Every one of these is REQUIRED when NODE_ENV=production (no defaults, no
# generated fallbacks — src/identity/config.ts). In dev they default:
# ES256 keys are generated once into apps/api/.dev-keys.json (gitignored).
#
# ERP_TOKEN_ISSUER=http://localhost:3001     our exact `iss`
# ERP_PUBLIC_URL=http://localhost:3001       public base URL (DPoP htu); set behind a proxy
# ERP_TRUST_PROXY=1                          behind Fly's proxy
# ERP_SIGNING_JWKS={"keys":[{...ES256 private JWK with kid...}]}   first key signs
# ERP_LEASE_JWKS={"keys":[{...}]}            SEPARATE ring for offline leases
# LEASE_FULL_HOURS=72                        T; refused above 336 (14 days)
# LEASE_GRACE_HOURS=24
#
# The identity provider (provider-generic OIDC; ADR-0003 A4). For the dev IdP
# run `pnpm dev:idp` and set:
# OIDC_ISSUER=http://localhost:9400
# OIDC_CLIENT_ID=erp-pwa-dev
# OIDC_ID_TOKEN_ALGS=ES256,EdDSA             HS* and none are refused
# OIDC_SCOPE=openid profile
# OIDC_JWKS_URI=                             optional override of discovery

# Where the dev server listens.
API_PORT=3001
API_HOST=127.0.0.1

# PowerSync service endpoint handed to clients by GET /sync/token.
POWERSYNC_URL=http://localhost:8080
