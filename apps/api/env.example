# @erp/api dev server — example environment.
# (Named env.example, not .env.example: this workspace's tooling denies
# writing/reading .env* paths as a secrets guard. Every value below is the
# default used when unset — `pnpm --filter @erp/api dev:stack` works bare
# against the running docker stack.)
# DEV VALUES ONLY — real secrets never live in the repository.

# Postgres 16 in docker (infra/), wal_level=logical.
# NOT the host's Postgres 14 on 5432.
DATABASE_URL=postgresql://erp:erp_dev@localhost:5433/erp

# The ONE HS256 secret shared by API-issued tokens and the PowerSync
# service's client_auth validation. /sync/token signs PowerSync client
# tokens with it: aud "powersync", claim "tid" (tenant uuid) from the
# VERIFIED session — sync rules read tid from the TOKEN, never from
# client parameters.
DEV_JWT_SECRET=dev-secret-change-me

# Where the dev server listens.
API_PORT=3001
API_HOST=127.0.0.1

# PowerSync service endpoint handed to clients by GET /sync/token.
POWERSYNC_URL=http://localhost:8080
