**/dist
**/.turbo
**/coverage
**/*.log
.git
.github
.claude
.env
.env.*
**/.env
**/.env.*
!**/env.example
docs
infra/postgres
infra/dev-tenants.json
**/*.dump
**/*.manifest.json
.DS_Store
