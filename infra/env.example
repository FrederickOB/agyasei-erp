# Local dev sync stack — example environment.
# (Named env.example, not .env.example: this workspace's tooling denies
# writing/reading .env* paths as a secrets guard. Copy to infra/.env yourself
# if you want overrides; every value below is the default used when unset.)
# DEV VALUES ONLY — real secrets never live in the repository.

# --- Postgres (docker, localhost:5433 — NOT the host's Postgres 14 on 5432) --
# In-container it is postgres:5432; db "erp", user "erp".
POSTGRES_PASSWORD=erp_dev

# Connection string the bootstrap/migrations use from the host:
DATABASE_URL=postgresql://erp:erp_dev@localhost:5433/erp

# --- PowerSync service (http://localhost:8080) -------------------------------
# Dedicated in-cluster roles (created by infra/postgres/init + bootstrap):
POWERSYNC_REPL_PASSWORD=powersync_dev
POWERSYNC_STORAGE_PASSWORD=powersync_dev

# --- Shared dev JWT secret ---------------------------------------------------
# ONE HS256 secret shared by API-issued tokens and the PowerSync service's
# client_auth validation. PowerSync client tokens carry aud "powersync" and
# claim "tid" (tenant uuid); sync rules read tid from the TOKEN, never from
# client parameters. The stack driver derives PS_JWT_K = base64url(this) —
# do not set PS_JWT_K by hand.
DEV_JWT_SECRET=dev-secret-change-me

# --- API dev server ----------------------------------------------------------
# The Fastify/tRPC dev server (wired by a later integration step) listens on:
API_PORT=3001
POWERSYNC_URL=http://localhost:8080
