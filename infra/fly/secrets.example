# PLACEHOLDERS ONLY. Copy OUTSIDE the repository, fill in, then:
#   fly secrets import -a <app> < that-file && rm that-file
# Never commit a filled-in copy. docs/production-runbook.md §2 says what each is.

# ── API app (also the release_command and the worker) ───────────────────────
DATABASE_URL=postgresql://erp_api.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
MIGRATE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
JOBS_DATABASE_URL=postgresql://erp_jobs.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# OPERATOR_DATABASE_URL=postgresql://erp_operator.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres   # only while provisioning
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n<Supabase CA, newlines as \n>\n-----END CERTIFICATE-----
ALERT_WEBHOOK_URL=https://<your alert sink>
JOBS_HEARTBEAT_URL=https://<your dead-man's switch ping URL>
# Identity (apps/api/src/identity/config.ts) — production refuses to start without these.
ERP_TOKEN_ISSUER=https://<api app>.fly.dev/
ERP_PUBLIC_URL=https://<api app>.fly.dev
ERP_SIGNING_JWKS=<node infra/scripts/gen-identity-keys.mjs signing-YYYY-MM>
ERP_LEASE_JWKS=<node infra/scripts/gen-identity-keys.mjs lease-YYYY-MM — a DIFFERENT key>
OIDC_ISSUER=https://<your OIDC provider's exact issuer>
OIDC_CLIENT_ID=<public client id at the provider: PKCE, no secret>
# OIDC_ID_TOKEN_ALGS=ES256,EdDSA   # set RS256 explicitly only if the provider requires it
# NEVER set DEV_JWT_SECRET here: production refuses to start with it.

# ── PowerSync app ───────────────────────────────────────────────────────────
PS_DATA_SOURCE_URI=postgresql://powersync_repl:<password>@db.<project-ref>.supabase.co:5432/postgres
PS_STORAGE_URI=postgresql://powersync_storage:<password>@db.<project-ref>.supabase.co:5432/powersync_storage
PS_PG_CA_CERT=-----BEGIN CERTIFICATE-----\n<Supabase CA>\n-----END CERTIFICATE-----
PS_JWKS_URI=https://<api app>.fly.dev/.well-known/jwks.json
PS_ADMIN_API_TOKEN=<openssl rand -base64 48>
